generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // MariaDB compatible
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TRAINER
  SALES
  MANAGER
  ADMIN
}

enum Product_Type {
  DURATION
  SESSION
}

enum Product_Category {
  Economy
  Business
  First_Class
}

enum DurationStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum Schedule_Type {
  APPOINTMENT
  DAY_OFF
  BREAK
  HOLIDAY
}

enum Log_Type {
  CHECK_IN
  CHECK_OUT
  BOOK_SESSION
  CANCEL_SESSION
}

model User {
  Username      String    @id @map("Username") @db.VarChar(100)
  Password      String    @db.VarChar(255)
  Role          Role
  First_Name    String    @db.VarChar(100)
  Last_Name     String    @db.VarChar(100)
  Gender        String?   @db.VarChar(20)
  Date_of_Birth DateTime? @db.Date
  Phone_Number  String?   @unique @db.VarChar(20)
  Gmail         String?   @unique @db.VarChar(150)
  Profile_Image String?   @db.Text
  Specialty     String?   @db.VarChar(100)
  Is_Active     Boolean   @default(true)
  Created_At    DateTime  @default(now())
  Updated_At    DateTime  @updatedAt

  // 1:1 กับ CUSTOMER
  Customer Customer?

  // Sales references
  salesDurations Customer_Duration[] @relation("DurationSales")
  salesSessions  Customer_Session[]  @relation("SessionSales")

  // Trainer references
  trainerSchedules Training_Schedule[] @relation("TrainerSchedules")
  trainerSessions  Customer_Session[]  @relation("SessionTrainer")
}

model Customer {
  Username String @id @db.VarChar(100)

  // Profile fields
  Health_Info                    String? @db.Text
  Address                        String? @db.Text
  Company_Name                   String? @db.VarChar(150)
  Company_Position               String? @db.VarChar(150)
  Marital_Status                 String? @db.VarChar(50)
  Emergency_Contact_Name         String? @db.VarChar(150)
  Emergency_Contact_Relationship String? @db.VarChar(100)
  Emergency_Contact_Phone        String? @db.VarChar(20)
  Marketing_Source               String? @db.VarChar(100)

  user User @relation(fields: [Username], references: [Username])

  durations Customer_Duration[]
  sessions  Customer_Session[]
  schedules Training_Schedule[] @relation("ScheduleCustomer")
  logs      Customer_Log[]

  @@map("CUSTOMER")
}

model Products {
  Product_Id       Int              @id @default(autoincrement())
  Name             String           @db.VarChar(150)
  Product_Type     Product_Type
  Product_Category Product_Category
  List_Price       Decimal          @db.Decimal(10, 2)
  Duration_Days    Int?
  Session_Amount   Int?
  Is_Active        Boolean          @default(true)
  Created_At       DateTime         @default(now())
  Updated_At       DateTime         @updatedAt

  durations Customer_Duration[]
  sessions  Customer_Session[]

  @@index([Product_Type, Product_Category])
  @@map("PRODUCTS")
}

model Customer_Duration {
  Duration_Id       Int            @id @default(autoincrement())
  Customer_Username String         @db.VarChar(100)
  Product_Id        Int
  Sales_Username    String?
  Purchase_Date     DateTime       @default(now())
  Start_Date        DateTime       @db.Date
  End_Date          DateTime       @db.Date
  Price_Paid        Decimal        @db.Decimal(10, 2)
  Discount_Amount   Decimal        @default(0) @db.Decimal(10, 2)
  Status            DurationStatus @default(ACTIVE)
  Created_At        DateTime       @default(now())
  Updated_At        DateTime       @updatedAt

  customer Customer @relation(fields: [Customer_Username], references: [Username])
  product  Products @relation(fields: [Product_Id], references: [Product_Id])
  sales    User?    @relation("DurationSales", fields: [Sales_Username], references: [Username])

  @@index([Customer_Username, Status])
  @@index([Product_Id])
  @@index([Sales_Username])
  @@map("CUSTOMER_DURATION")
}

model Customer_Session {
  Session_Id        Int           @id @default(autoincrement())
  Customer_Username String        @db.VarChar(100)
  Trainer_Username  String?
  Product_Id        Int
  Sales_Username    String?
  Purchase_Date     DateTime      @default(now())
  Total_Sessions    Int
  Used_Sessions     Int           @default(0)
  Price_Paid        Decimal       @db.Decimal(10, 2)
  Discount_Amount   Decimal       @default(0) @db.Decimal(10, 2)
  Status            SessionStatus @default(ACTIVE)
  Created_At        DateTime      @default(now())
  Updated_At        DateTime      @updatedAt

  customer Customer @relation(fields: [Customer_Username], references: [Username])
  trainer  User?    @relation("SessionTrainer", fields: [Trainer_Username], references: [Username])
  product  Products @relation(fields: [Product_Id], references: [Product_Id])
  sales    User?    @relation("SessionSales", fields: [Sales_Username], references: [Username])

  schedules Training_Schedule[]

  @@index([Customer_Username, Status])
  @@index([Trainer_Username])
  @@index([Product_Id])
  @@index([Sales_Username])
  @@map("CUSTOMER_SESSION")
}

model Training_Schedule {
  Schedule_Id       Int           @id @default(autoincrement())
  Trainer_Username  String
  Customer_Username String?
  Session_Id        Int?
  Start_Time        DateTime
  End_Time          DateTime
  Schedule_Type     Schedule_Type
  Created_At        DateTime      @default(now())
  Updated_At        DateTime      @updatedAt

  trainer  User              @relation("TrainerSchedules", fields: [Trainer_Username], references: [Username])
  customer Customer?         @relation("ScheduleCustomer", fields: [Customer_Username], references: [Username])
  session  Customer_Session? @relation(fields: [Session_Id], references: [Session_Id])

  @@index([Trainer_Username, Start_Time])
  @@index([Customer_Username])
  @@index([Session_Id])
  @@map("TRAINING_SCHEDULE")
}

model Customer_Log {
  Log_Id            Int      @id @default(autoincrement())
  Customer_Username String   @db.VarChar(100)
  Timestamp         DateTime @default(now())
  Log_Type          Log_Type
  Detail            String?  @db.Text

  customer Customer @relation(fields: [Customer_Username], references: [Username])

  @@index([Customer_Username, Timestamp])
  @@map("CUSTOMER_LOG")
}
